# =======================================================
# JS DRY FISH SHOP - SUPABASE & DEPLOY CONFIGURATION
# =======================================================
# 1. Go to https://supabase.com -> Create a free project.
# 2. Go to Project Settings -> API.
# 3. Copy "Project URL" and paste into VITE_SUPABASE_URL.
# 4. Copy "anon public" Key and paste into VITE_SUPABASE_ANON_KEY.
# 5. Open Supabase SQL Editor and run the file: supabase/schema.sql

VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key-here

# Optional: If you deploy a separate Python FastAPI backend (e.g. Render)
# VITE_API_BASE_URL=https://your-api.onrender.com
